# Football Pipeline — environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# .env is the ONLY place for secrets. It overrides config.yaml (env > config).
# NEVER commit a real .env or put tokens/passwords in config.yaml.

# --- Database (required for DB/orchestrator mode) ---
MYSQL_HOST=your-database-host.ondigitalocean.com
MYSQL_PORT=25060
MYSQL_USER=scoutbridge
MYSQL_PASSWORD=your-secure-password-here      # SECRET
MYSQL_DB=footballgallery
TABLE_NAME=MatchesVideoAnalysis_test

# --- ScoutBridge API (required for poll/upload mode) ---
SBG_BASE=https://api-staging.scoutbridge.net/football-gallery/api
SBG_TOKEN=your-jwt-token-here                 # SECRET

# --- Optional overrides (else config.yaml wins) ---
# Model paths — the CURRENT models (match config.yaml):
# DET_WEIGHTS=models/yolo_player.pt
# JNR_WEIGHTS=models/resnet34_clean.pt
# BALL_MODEL_PATH=models/nabeel_best.pt
# GOAL_MODEL_PATH=models/nabeel_best.pt
# POSE_WEIGHTS=models/yolo_pitch.pt          # optional (homography only)

# Processing overrides:
# SRC_VIDEO=test_videos/your_video.mp4
# VID_STRIDE=3
# DET_IMG_SIZE=640

# --- Event detection & clips (REQUIRED for the shots/goals/assists product) ---
# CLIPPER_RECALL turns ON the hardened shot detection (keeper-anchored shots +
# R21 precision). WITHOUT it the pipeline reverts to the old behaviour and the
# shots feature is effectively off — set this in production.
CLIPPER_RECALL=1
# Shot precision knobs (defaults shown). Lower the floor for more candidate
# clips; raise it for a stricter set. Set the goalmouth fraction to 0 to disable
# the near-goal override.
R21_SHOT_MIN_CONF=0.45
R21_GOALMOUTH_FRAC=0.10
# NOTE: writing the clips also requires the orchestrator/pipeline to be started
# with  --clip_events shot,goal,assist,goal_restart  (see the systemd unit).
# Clip length is 8s (clip_pad_s default 4.0); override with --clip_pad_s.
