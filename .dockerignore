# Build context hygiene - keep the image small and the build fast.
.git
.gitignore
venv/
.venv/
__pycache__/
*.py[cod]

# Media: test videos are multi-GB and must never enter the context.
test_videos/
output/
output_*/
clips/
*.mp4
*.webm
*.avi
*.mkv

# Local state
.env
*.log
reports/
tasks/
ground_truth/
debug_*.json
raw_tracks.json
